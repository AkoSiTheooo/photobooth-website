# Copy to .env.local and fill in from the Supabase project's Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Salt for the visitor IP hash in the booth rate limit. Any long random string.
UPLOAD_IP_SALT=replace_me
